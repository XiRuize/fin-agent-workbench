{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XiRuize/fin-agent-workbench/packages/contracts/artifact-manifest.schema.json",
  "title": "ArtifactManifest",
  "description": "Immutable record of a rendered deliverable and the inputs/version it came from.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "version",
    "files",
    "inputs",
    "created_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "git_commit": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{7,40}$"
    },
    "tag": {
      "type": ["string", "null"]
    },
    "template": {
      "type": ["string", "null"]
    },
    "model": {
      "type": ["string", "null"]
    },
    "prompt_version": {
      "type": ["string", "null"]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": ["integer", "null"], "minimum": 0 },
          "media_type": { "type": ["string", "null"] }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "approved_by": {
      "type": ["string", "null"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
