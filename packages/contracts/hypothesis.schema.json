{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XiRuize/fin-agent-workbench/packages/contracts/hypothesis.schema.json",
  "title": "Hypothesis",
  "description": "A research hypothesis with evidence, falsifiers, approval status and optional valuation impact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "thesis",
    "status",
    "confidence",
    "evidence_for",
    "evidence_against",
    "falsifiers",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^h_[a-z0-9]{6,32}$"
    },
    "thesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "status": {
      "enum": [
        "draft",
        "submitted",
        "under_review",
        "approved",
        "rejected",
        "conditional",
        "frozen"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_for": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "evidence_against": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "falsifiers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "valuation_impact": {
      "oneOf": [
        { "$ref": "#/$defs/valuationImpact" },
        { "type": "null" }
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_version": {
      "type": ["integer", "null"],
      "minimum": 1
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "locator": { "type": ["string", "null"] },
        "quote": { "type": ["string", "null"] },
        "as_of": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "valuationImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "from": { "type": ["number", "null"] },
        "to": { "type": ["number", "null"] }
      }
    }
  }
}
